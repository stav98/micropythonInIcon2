        "id": "f1b24af34da7235e",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 1",
        "func": "//Διάβασε μεταβλητή ορατή μόνο στο Flow.\n//Την 1η φορά δεν έχει οριστεί, θα πάρει τιμή 'OFF'\nlet cur_state = flow.get('POWER1_STATE') || \"OFF\";\nlet a = msg.payload; //Διάβασε μήνυμα από προηγούμενο κόμβο \nif (cur_state != a) //Αν υπάρχει αλλαγή κατάστασης\n   {\n    msg.payload = a; //Να προωθήσεις την νέα κατάσταση\n    //Αποθήκευσε την νέα κατάσταση για την επόμενη φορά\n    flow.set('POWER1_STATE', a);\n    return msg;\n   }",
